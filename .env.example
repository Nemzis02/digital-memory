# Runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=8080
# Leave both unset for long polling. Required together once the process is reachable over HTTPS.
# PUBLIC_URL=
# TELEGRAM_WEBHOOK_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=123456789

# PostgreSQL
POSTGRES_USER=digital_memory
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=digital_memory
POSTGRES_PORT=5432
DATABASE_URL=postgresql://digital_memory:CHANGE_ME@localhost:5432/digital_memory

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=digital_memory

# Cloudflare R2 (private bucket — never expose public URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=digital-memory
R2_PRESIGN_TTL_SECONDS=900

# Fast model and embeddings. The strong model answers every text message.
LLM_FAST_API_KEY=
LLM_STRONG_API_KEY=
