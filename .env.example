# Runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=8080
# Leave all three unset for long polling. Required together once the process is reachable over
# HTTPS: the webhook secret authenticates Telegram updates, and the OIDC client secret (BotFather,
# Login Widget, OpenID Connect) lets the OAuth issuer finish a Telegram login.
# PUBLIC_URL=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_OIDC_CLIENT_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=123456789

# PostgreSQL
POSTGRES_USER=digital_memory
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=digital_memory
POSTGRES_PORT=5432
DATABASE_URL=postgresql://digital_memory:CHANGE_ME@localhost:5432/digital_memory

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=digital_memory

# Cloudflare R2 (private bucket — never expose public URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=digital-memory
R2_PRESIGN_TTL_SECONDS=900

# Fast model and embeddings. The strong model answers every text message.
LLM_FAST_API_KEY=
LLM_STRONG_API_KEY=

# MCP and OAuth issuer (optional). Token lifetimes in seconds; the file cap is the decoded size.
# OAUTH_ACCESS_TTL_SECONDS=3600
# OAUTH_REFRESH_TTL_SECONDS=2592000
# MCP_MAX_FILE_BYTES=10485760

# Langfuse tracing (optional). Leave both keys unset to export no traces.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
