# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_ADMIN_ID=123456789

# Qdrant Cloud
QDRANT_URL=https://xxxxxxxx.eu-central.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=digital_memory

# Cloudflare R2 (private bucket — never expose public URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=digital-memory
R2_PRESIGN_TTL_SECONDS=900

# LLM routing (Gemini / Anthropic)
LLM_API_KEY=
