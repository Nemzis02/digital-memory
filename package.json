{
  "name": "digital-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud-native personal second brain: Telegram ingestion, hybrid RAG, MCP access.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "${COMPOSE:-podman compose} up -d",
    "db:down": "${COMPOSE:-podman compose} down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "LLM_LIVE=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run src/core/eval/run.live.test.ts",
    "eval:accept": "node src/core/eval/accept.ts",
    "reindex": "node --env-file=.env src/core/vector/reindex-cli.ts",
    "eval:sparse": "LLM_LIVE=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run src/core/eval/sparse.live.test.ts",
    "test:live": "LLM_LIVE=1 INGEST_LIVE=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run src/core/llm/live.test.ts src/core/pipeline/live.test.ts src/core/agent/live.test.ts",
    "prepare": "husky",
    "commit": "czg"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/google": "^4.0.93",
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@grammyjs/auto-retry": "^2.0.2",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.6",
    "@langfuse/client": "^6.0.2",
    "@langfuse/otel": "^6.0.2",
    "@langfuse/tracing": "^6.0.2",
    "@langfuse/vercel-ai-sdk": "^6.0.2",
    "@mozilla/readability": "^0.6.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/otlp-exporter-base": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@qdrant/js-client-rest": "^1.12.0",
    "ai": "^7.0.150",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.1.1",
    "grammy": "^1.30.0",
    "linkedom": "^0.18.13",
    "md-to-telegram": "^0.1.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "czg": "^1.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "undici": "^7.29.1"
  }
}
